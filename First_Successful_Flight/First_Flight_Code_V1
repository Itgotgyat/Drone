  Serial.println("ESCs idle (1000us).");

#if ESC_CAL_MODE
  // ESC calibration: full throttle first, then minimum. Props must be off.
  motor1.writeMicroseconds(2000);
  motor2.writeMicroseconds(2000);
  motor3.writeMicroseconds(2000);
  motor4.writeMicroseconds(2000);
  delay(6000);

  motor1.writeMicroseconds(1000);
  motor2.writeMicroseconds(1000);
  motor3.writeMicroseconds(1000);
  motor4.writeMicroseconds(1000);
  delay(6000);
#endif

  // Start Wi-Fi early so the access point is up even if a sensor fails
  WiFi.softAP(ssid, password);
  Serial.print("AP up at ");
  Serial.println(WiFi.softAPIP());

  // Wireless code upload
  ArduinoOTA.setHostname("drone");
  ArduinoOTA.onStart([]() {
    armed = false;
    stopMotors();
  });
  ArduinoOTA.begin();

  // Sensors. Report a failure but keep going.
  Wire.begin(SDA_PIN, SCL_PIN);
  Wire.setClock(400000);

  myIMU.settings.gyroEnabled = 1;
  myIMU.settings.gyroRange = 2000; // dps
  myIMU.settings.gyroSampleRate = 416; // Hz
  myIMU.settings.accelEnabled = 1;
  myIMU.settings.accelRange = 8; // g
  myIMU.settings.accelSampleRate = 416; // Hz

  bool imuOk = (myIMU.begin() == 0);
  bool tofOk = l0x.begin(0x29, false, &Wire);

  if (!imuOk) {
    Serial.println("LSM6DS3 init FAILED - flight task will NOT start");
  }
  if (!tofOk) {
    Serial.println("VL53L0X init FAILED - altitude data unavailable");
  }

  if (tofOk) {
    l0x.setMeasurementTimingBudgetMicroSeconds(30000);
    l0x.startRangeContinuous();
  }

  // SD card
  SPI.begin(SD_SCK_PIN, SD_MISO_PIN, SD_MOSI_PIN, SD_CS_PIN);
  if (SD.begin(SD_CS_PIN, SPI, 20000000)) {
    sdCardReady = true;
    logFile = SD.open("/flight_log.csv", FILE_APPEND);
    if (logFile && logFile.size() == 0) {
      logFile.println("timestamp_ms,roll,pitch,yaw,gyroX,gyroY,gyroZ,accelX,accelY,accelZ,tof_mm,alt_mm,m1,m2,m3,m4");
      logFile.flush();
    }
    Serial.println("SD ready.");
  } else {
    Serial.println("SD init failed (logging disabled).");
  }

  logQueue = xQueueCreate(200, sizeof(LogFrame));

  // Only calibrate and start flying if the IMU works
  if (imuOk) {
    calibrateSensors();

    // Runs on core 1 at a higher priority than loop(), which is priority 1
    xTaskCreatePinnedToCore(
      flightControlTask,
      "FlightLoop",
      8192,
      NULL,
      10,
      NULL,
      1
    );
  }

  // Web routes
  server.on("/", []() {
    server.send(200, "text/html", HTML_CONTROLLER);
  });

  server.on("/estop", []() {
    emergencyStop = true;
    armed = false;
    cmdThrottle = 0;
    cmdRoll = 0;
    cmdPitch = 0;
    cmdYaw = 0;
    stopMotors();
    server.send(200, "text/plain", "ESTOP_TRIGGERED");
  });

  server.on("/clear_estop", []() {
    emergencyStop = false;
    server.send(200, "text/plain", "ESTOP_CLEARED");
  });

  server.on("/start_calibrate", []() {
    if (!armed) {
      requestCalibration = true;
      server.send(200, "text/plain", "STARTED");
    } else {
      server.send(400, "text/plain", "CANNOT_CALIBRATE_WHILE_ARMED");
    }
  });

  server.on("/calibrate_status", []() {
    String json = "{";
    if (isCalibrating) {
      json += "\"status\":\"RUNNING\",\"progress\":" + String(calibrationProgress);
    } else if (requestCalibration) {
      json += "\"status\":\"RUNNING\",\"progress\":0";
    } else {
      json += "\"status\":\"DONE\",\"progress\":100";
    }
    json += "}";
    server.send(200, "application/json", json);
  });

  server.on("/set_trim", []() {
    if (server.hasArg("r")) {
      trimRoll = server.arg("r").toFloat();
    }
    if (server.hasArg("p")) {
      trimPitch = server.arg("p").toFloat();
    }
    server.send(200, "text/plain", "TRIM_UPDATED");
  });

  // Change gains without reflashing, only while disarmed. Example:
  //   http://192.168.4.1/set_gains?ap=3.5&rp=0.8&ri=0.6&rd=0.004&yp=1.0&yi=0.2
  // ap is the angle P gain. rp, ri and rd are the roll and pitch rate P, I and D.
  // yp and yi are the yaw rate P and I.
  server.on("/set_gains", []() {
    if (armed) {
      server.send(400, "text/plain", "DISARM_FIRST");
      return;
    }

    if (server.hasArg("ap")) {
      anglePGain = clampf(server.arg("ap").toFloat(), 0.0f, 10.0f);
    }

    if (server.hasArg("rp")) {
      float v = clampf(server.arg("rp").toFloat(), 0.0f, 3.0f);
      rollRatePID.kp = v;
      pitchRatePID.kp = v;
    }

    if (server.hasArg("ri")) {
      float v = clampf(server.arg("ri").toFloat(), 0.0f, 5.0f);
      rollRatePID.ki = v;
      pitchRatePID.ki = v;
    }

    if (server.hasArg("rd")) {
      float v = clampf(server.arg("rd").toFloat(), 0.0f, 0.05f);
      rollRatePID.kd = v;
      pitchRatePID.kd = v;
    }

    if (server.hasArg("yp")) {
      yawRatePID.kp = clampf(server.arg("yp").toFloat(), 0.0f, 3.0f);
    }

    if (server.hasArg("yi")) {
      yawRatePID.ki = clampf(server.arg("yi").toFloat(), 0.0f, 3.0f);
    }

    server.send(200, "text/plain", "GAINS_UPDATED");
  });

  server.on("/gains", []() {
    String json = "{";
    json += "\"ap\":" + String((float)anglePGain, 3) + ",";
    json += "\"rp\":" + String(rollRatePID.kp, 3) + ",";
    json += "\"ri\":" + String(rollRatePID.ki, 3) + ",";
    json += "\"rd\":" + String(rollRatePID.kd, 4) + ",";
    json += "\"yp\":" + String(yawRatePID.kp, 3) + ",";
    json += "\"yi\":" + String(yawRatePID.ki, 3);
    json += "}";
    server.send(200, "application/json", json);
  });

  server.on("/telemetry", []() {
    String json = "{";
    json += "\"roll\":" + String(rollAngle, 1) + ",";
    json += "\"pitch\":" + String(pitchAngle, 1) + ",";
    json += "\"yaw\":" + String(yawAngle, 1) + ",";
    json += "\"tof\":" + String(filteredToF, 1) + ",";
    json += "\"alt\":" + String(altitudeAGL, 1) + ",";
    json += "\"ax\":" + String(curAx, 2) + ",";
    json += "\"ay\":" + String(curAy, 2) + ",";
    json += "\"az\":" + String(curAz, 2) + ",";
    json += "\"gx\":" + String(curGx, 1) + ",";
    json += "\"gy\":" + String(curGy, 1) + ",";
    json += "\"gz\":" + String(curGz, 1) + ",";
    json += "\"up\":" + String(millis()) + ",";
    json += "\"m1\":" + String((int)dbgM1) + ",";
    json += "\"m2\":" + String((int)dbgM2) + ",";
    json += "\"m3\":" + String((int)dbgM3) + ",";
    json += "\"m4\":" + String((int)dbgM4) + ",";
    json += "\"armed\":" + String(armed ? 1 : 0) + ",";
    json += "\"failsafe\":" + String(failsafeTripped ? 1 : 0);
    json += "}";
    server.send(200, "application/json", json);
  });

  server.on("/start_logging", []() {
    if (server.hasArg("time")) {
      uint64_t laptopTime = strtoull(server.arg("time").c_str(), NULL, 10);
      laptopTimeOffset = laptopTime - millis();
    }
    isLogging = true;
    server.send(200, "text/plain", "LOGGING_STARTED");
  });

  server.on("/stop_logging", []() {
    isLogging = false;
    if (logFile) {
      logFile.flush();
    }
    server.send(200, "text/plain", "LOGGING_STOPPED");
  });

  server.on("/cmd", []() {
    lastCmdMs = millis();

    if (server.hasArg("arm")) {
      bool armReq = (server.arg("arm").toInt() == 1);

      // Zero the commands on every arm or disarm
      cmdThrottle = 0;
      cmdRoll = 0;
      cmdPitch = 0;
      cmdYaw = 0;

      if (armReq && !emergencyStop) {
        failsafeTripped = false;
        armed = true;
      } else if (!armReq) {
        armed = false;
      }
    }

    if (armed) {
      if (server.hasArg("t")) {
        cmdThrottle = clampf(server.arg("t").toFloat(), 0.0f, 1.0f);
      }
      if (server.hasArg("r")) {
        cmdRoll = clampf(server.arg("r").toFloat(), -1.0f, 1.0f);
      }
      if (server.hasArg("p")) {
        cmdPitch = clampf(server.arg("p").toFloat(), -1.0f, 1.0f);
      }
      if (server.hasArg("y")) {
        cmdYaw = clampf(server.arg("y").toFloat(), -1.0f, 1.0f);
      }
    }

    server.send(200, "text/plain", "OK");
  });

  server.begin();
  Serial.println("Flight controller initialized.");
}

void stopMotors() {
  motor1.writeMicroseconds(DISARMED_PWM);
  motor2.writeMicroseconds(DISARMED_PWM);
  motor3.writeMicroseconds(DISARMED_PWM);
  motor4.writeMicroseconds(DISARMED_PWM);
}

// Clears the filters and estimator, used after calibration
void resetEstimator() {
  fGx = 0.0f;
  fGy = 0.0f;
  fGz = 0.0f;

  fAx = 0.0f;
  fAy = 0.0f;
  fAz = 1.0f;

  fRollD = 0.0f;
  fPitchD = 0.0f;

  prevRollRate = 0.0f;
  prevPitchRate = 0.0f;

  rollI = 0.0f;
  pitchI = 0.0f;
  yawI = 0.0f;

  kalmanRoll.reset();
  kalmanPitch.reset();
}

// Arduino loop task. Handles the web server, OTA, calibration requests and SD writes.
void loop() {
  server.handleClient();
  ArduinoOTA.handle();

  if (requestCalibration && !armed) {
    requestCalibration = false;
    calibrateSensors();
  }

  if (sdCardReady && logFile && isLogging) {
    LogFrame frame;
    while (xQueueReceive(logQueue, &frame, 0) == pdTRUE) {
      logFile.printf("%llu,%.2f,%.2f,%.2f,%.2f,%.2f,%.2f,%.2f,%.2f,%.2f,%.1f,%.1f,%d,%d,%d,%d\n",
        frame.timestamp, frame.roll, frame.pitch, yawAngle,
        frame.gyroX, frame.gyroY, frame.gyroZ,
        curAx, curAy, curAz,
        frame.tofDist, altitudeAGL,
        frame.m1, frame.m2, frame.m3, frame.m4
      );
    }

    static uint32_t lastFlush = 0;
    if (millis() - lastFlush > 500) {
      logFile.flush();
      lastFlush = millis();
    }
  }

#if DEBUG_SERIAL
  static uint32_t lastPrint = 0;
  if (millis() - lastPrint > 100) {
    lastPrint = millis();
    Serial.printf("armed:%d thr:%.2f | roll:%.1f pitch:%.1f | gx:%.1f gy:%.1f gz:%.1f | M1:%d M2:%d M3:%d M4:%d | loopMax:%luus\n",
      (int)armed, (float)cmdThrottle, (float)rollAngle, (float)pitchAngle,
      (float)curGx, (float)curGy, (float)curGz,
      (int)dbgM1, (int)dbgM2, (int)dbgM3, (int)dbgM4,
      (unsigned long)dbgLoopMaxUs);
    dbgLoopMaxUs = 0;
  }
#endif

  // Give the idle task time to run
  delay(1);
}

// Flight task. Runs on core 1 at priority 10, 200 Hz.
void flightControlTask(void *pvParameters) {
  TickType_t xLastWakeTime = xTaskGetTickCount();
  const TickType_t period = pdMS_TO_TICKS(5);
  uint32_t lastUs = micros();
  uint8_t imuFails = 0;

  while (1) {
    vTaskDelayUntil(&xLastWakeTime, period);

    // Sit idle while calibrating
    if (isCalibrating) {
      stopMotors();
      lastUs = micros();
      vTaskDelay(pdMS_TO_TICKS(10));
      xLastWakeTime = xTaskGetTickCount(); // resync so the delay doesn't try to catch up
      continue;
    }

    uint32_t nowUs = micros();
    float dt = (nowUs - lastUs) * 1e-6f;
    lastUs = nowUs;
    dt = constrain(dt, 0.002f, 0.020f);

    // Read the IMU
    float sGx;
    float sGy;
    float sGz;
    float sAx;
    float sAy;
    float sAz;

    if (!readIMU(sGx, sGy, sGz, sAx, sAy, sAz)) {
      if (++imuFails > 10) {
        armed = false;
        stopMotors();
      }
      continue;
    }
    imuFails = 0;

    float rawGx = sGx - gyroBiasX;
    float rawGy = sGy - gyroBiasY;
    float rawGz = sGz - gyroBiasZ;

    float rawAx = sAx - accelBiasX;
    float rawAy = sAy - accelBiasY;
    float rawAz = sAz - accelBiasZ;

    // Gyro low-pass, about 45 Hz cutoff at 200 Hz
    fGx += GYRO_LPF_ALPHA * (rawGx - fGx);
    fGy += GYRO_LPF_ALPHA * (rawGy - fGy);
    fGz += GYRO_LPF_ALPHA * (rawGz - fGz);

    // Remap the axes because the board is rotated 90 degrees clockwise
    curAx = rawAy;
    curAy = -rawAx;
    curAz = rawAz;

    curGx = -fGy; // roll rate
    curGy = fGx; // pitch rate
    curGz = fGz; // yaw rate

    // Accel low-pass
    fAx += ACCEL_LPF_ALPHA * (curAx - fAx);
    fAy += ACCEL_LPF_ALPHA * (curAy - fAy);
    fAz += ACCEL_LPF_ALPHA * (curAz - fAz);

    // Angle estimate
    float accelRoll = atan2(fAy, fAz) * 57.2958f;
    float accelPitch = atan2(-fAx, sqrt(fAy * fAy + fAz * fAz)) * 57.2958f;

    // Ignore the accelerometer when total g is far from 1
    float totalG = sqrt(fAx * fAx + fAy * fAy + fAz * fAz);
    bool trustAccel = (totalG > 0.82f && totalG < 1.18f);

    // Trust the accelerometer much less once the throttle is up
    float rMeas = (armed && cmdThrottle >= 0.10f) ? 100.0f : 0.5f;
    kalmanRoll.R_measure = rMeas;
    kalmanPitch.R_measure = rMeas;

    rollAngle = kalmanRoll.update(accelRoll, curGx, dt, trustAccel);
    pitchAngle = kalmanPitch.update(accelPitch, curGy, dt, trustAccel);
    yawAngle += curGz * dt;

    // Read the ToF sensor without blocking
    if (l0x.isRangeComplete()) {
      uint16_t distMm = l0x.readRange();
      if (distMm > 10 && distMm < 1200) {
        float rawMm = (float)distMm + tofOffset;
        filteredToF = (0.15f * rawMm) + (0.85f * filteredToF);
        altitudeAGL = max(0.0f, filteredToF - TARGET_GROUND_HEIGHT);
      }
    }

    // Command-loss failsafe removed

    // Motors off and estimator held while disarmed or in e-stop
    if (!armed || emergencyStop) {
      stopMotors();

      kalmanRoll.angle = accelRoll;
      kalmanPitch.angle = accelPitch;
      yawAngle = 0.0f;

      rollI = 0.0f;
      pitchI = 0.0f;
      yawI = 0.0f;

      prevRollRate = curGx;
      prevPitchRate = curGy;
      fRollD = 0.0f;
      fPitchD = 0.0f;

      dbgM1 = DISARMED_PWM;
      dbgM2 = DISARMED_PWM;
      dbgM3 = DISARMED_PWM;
      dbgM4 = DISARMED_PWM;
      continue;
    }

    // Below this throttle the drone is treated as still on the ground
    float thr = (float)cmdThrottle;
    bool onGround = (thr < 0.40f);
    if (onGround) {
      kalmanRoll.angle = accelRoll;
      kalmanPitch.angle = accelPitch;
      yawAngle = 0.0f;

      rollI = 0.0f;
      pitchI = 0.0f;
      yawI = 0.0f;

      prevRollRate = curGx;
      prevPitchRate = curGy;
      fRollD = 0.0f;
      fPitchD = 0.0f;
    }

    // Setpoints
    float targetRollAngle = ((float)cmdRoll * 12.0f) + trimRoll;
    float targetPitchAngle = (-(float)cmdPitch * 12.0f) + trimPitch;
    float targetYawRate = (float)cmdYaw * 40.0f;

    float aP = anglePGain;

    // Roll
    float rollAngleError = targetRollAngle - rollAngle;
    float targetRollRate = rollAngleError * aP;
    float rollRateError = targetRollRate - curGx;

    float rollILim = I_OUT_LIMIT / max(rollRatePID.ki, 0.001f);
    rollI += rollRateError * dt;
    rollI = constrain(rollI, -rollILim, rollILim);

    // D term uses the gyro, not the error, so setpoint changes don't kick it
    float rollGyroDot = (curGx - prevRollRate) / dt;
    fRollD = 0.60f * fRollD + 0.40f * rollGyroDot;
    prevRollRate = curGx;

    float rollOutput = (rollRatePID.kp * rollRateError) + (rollRatePID.ki * rollI) - (rollRatePID.kd * fRollD);

    // Pitch
    float pitchAngleError = targetPitchAngle - pitchAngle;
    float targetPitchRate = pitchAngleError * aP;
    float pitchRateError = targetPitchRate - curGy;

    float pitchILim = I_OUT_LIMIT / max(pitchRatePID.ki, 0.001f);
    pitchI += pitchRateError * dt;
    pitchI = constrain(pitchI, -pitchILim, pitchILim);

    float pitchGyroDot = (curGy - prevPitchRate) / dt;
    fPitchD = 0.60f * fPitchD + 0.40f * pitchGyroDot;
    prevPitchRate = curGy;

    float pitchOutput = (pitchRatePID.kp * pitchRateError) + (pitchRatePID.ki * pitchI) - (pitchRatePID.kd * fPitchD);

    // Yaw
    float yawRateError = targetYawRate - curGz;

    float yawILim = YAW_I_OUT_LIMIT / max(yawRatePID.ki, 0.001f);
    yawI += yawRateError * dt;
    yawI = constrain(yawI, -yawILim, yawILim);

    float yawOutput = YAW_FEEDBACK_SIGN * ((yawRatePID.kp * yawRateError) + (yawRatePID.ki * yawI));

    // Limit how much each axis can change the motors
    rollOutput = constrain(rollOutput, -180.0f, 180.0f);
    pitchOutput = constrain(pitchOutput, -180.0f, 180.0f);
    yawOutput = constrain(yawOutput, -80.0f, 80.0f);

    // Mixer
    float cappedThrottle = constrain(thr, 0.0f, 0.88f);
    int throttlePWM = MIN_THROTTLE + (int)(cappedThrottle * (MAX_THROTTLE - MIN_THROTTLE));

    int o1 = (int)rollOutput + (int)pitchOutput + (int)yawOutput; // M1, front left, CCW
    int o2 = (int)rollOutput - (int)pitchOutput - (int)yawOutput; // M2, rear left, CW
    int o3 = -(int)rollOutput - (int)pitchOutput + (int)yawOutput; // M3, rear right, CCW
    int o4 = -(int)rollOutput + (int)pitchOutput - (int)yawOutput; // M4, front right, CW

    int hi = max(max(o1, o2), max(o3, o4));
    int lo = min(min(o1, o2), min(o3, o4));

    // If a motor would clip, shift all four together so the differences stay intact
    int base = throttlePWM;
    int overshootHi = (base + hi) - MAX_THROTTLE;
    int overshootLo = MIN_THROTTLE - (base + lo);

    if (overshootHi > 0 && overshootLo <= 0) {
      base -= overshootHi;
    } else if (overshootLo > 0 && overshootHi <= 0 && !onGround) {
      base += min(overshootLo, MAX_UPSHIFT_US);
    }

    int m1 = constrain(base + o1, MIN_THROTTLE, MAX_THROTTLE);
    int m2 = constrain(base + o2, MIN_THROTTLE, MAX_THROTTLE);
    int m3 = constrain(base + o3, MIN_THROTTLE, MAX_THROTTLE);
    int m4 = constrain(base + o4, MIN_THROTTLE, MAX_THROTTLE);

    motor1.writeMicroseconds(m1);
    motor2.writeMicroseconds(m2);
    motor3.writeMicroseconds(m3);
    motor4.writeMicroseconds(m4);

    dbgM1 = m1;
    dbgM2 = m2;
    dbgM3 = m3;
    dbgM4 = m4;

    if (isLogging) {
      LogFrame frame = {
        millis() + laptopTimeOffset,
        rollAngle, pitchAngle,
        curGx, curGy, curGz,
        filteredToF,
        m1, m2, m3, m4
      };
      xQueueSend(logQueue, &frame, 0);
    }

    uint32_t elapsed = micros() - nowUs;
    if (elapsed > dbgLoopMaxUs) {
      dbgLoopMaxUs = elapsed;
    }
  }
}

// Sensor calibration. The drone must be level and still.
void calibrateSensors() {
  isCalibrating = true;
  stopMotors();

  // Let the flight task finish its current pass and go idle
  delay(100);

  calibrationProgress = 0;

  const int numSamples = 250;
  float aSumX = 0;
  float aSumY = 0;
  float aSumZ = 0;
  float gSumX = 0;
  float gSumY = 0;
  float gSumZ = 0;
  int good = 0;

  for (int i = 0; i < numSamples; i++) {
    float gx;
    float gy;
    float gz;
    float ax;
    float ay;
    float az;

    if (readIMU(gx, gy, gz, ax, ay, az)) {
      aSumX += ax;
      aSumY += ay;
      aSumZ += az;
      gSumX += gx;
      gSumY += gy;
      gSumZ += gz;
      good++;
    }

    if (i % 5 == 0) {
      calibrationProgress = (i * 85) / numSamples;
      server.handleClient();
    }
    delay(5);
  }

  if (good > 0) {
    accelBiasX = aSumX / good;
    accelBiasY = aSumY / good;
    accelBiasZ = (aSumZ / good) - 1.0f; // take out 1 g of gravity on the vertical axis

    gyroBiasX = gSumX / good;
    gyroBiasY = gSumY / good;
    gyroBiasZ = gSumZ / good;
  }

  float tofSum = 0;
  int validTofSamples = 0;

  for (int i = 0; i < 10; i++) {
    if (l0x.isRangeComplete()) {
      tofSum += l0x.readRange();
      validTofSamples++;
    }
    calibrationProgress = 85 + (i * 15 / 10);
    server.handleClient();
    delay(20);
  }

  if (validTofSamples > 0) {
    tofOffset = TARGET_GROUND_HEIGHT - (tofSum / validTofSamples);
  }

  resetEstimator();
  yawAngle = 0.0f;
  calibrationProgress = 100;
  delay(100);
  isCalibrating = false;
}

